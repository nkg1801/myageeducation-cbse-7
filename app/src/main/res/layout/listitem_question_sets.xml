<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:ads="http://schemas.android.com/apk/res-auto"
              android:id="@+id/linearLayoutParent"
                android:layout_width="fill_parent"
                android:layout_height="100dp"
              android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:background="@color/colorLightBlack"
                android:descendantFocusability="blocksDescendants"
                android:padding="0dp">

    <ImageView
        android:id="@+id/imageViewLock"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:contentDescription="@string/image"
        android:background="@color/colorLightBlack"
        android:src="@drawable/ic_lock_outline_white_24dp"/>

    <ImageView
        android:id="@+id/imageViewLockOpen"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:contentDescription="@string/image"
        android:background="@color/colorLightBlack"
        android:visibility="gone"
        android:src="@drawable/ic_lock_open_white_24dp"/>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_weight="0.8"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_height="match_parent">
        
        <TextView
            android:id="@+id/textViewQuestionSetNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/colorLightBlack"
            android:gravity="center_horizontal|bottom"
            android:textColor="@color/colorLightYellow"
            android:textSize="16sp"
            android:text="Question Set #1"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/textViewUnlockMessage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/textViewQuestionSetNumber"
            android:background="@color/colorLightBlack"
            android:gravity="center_horizontal|top"
            android:textColor="@color/colorGrey"
            android:textSize="12sp"
            android:padding="5dp"
            android:text="Unlock this set by watching the adjoining Video Ad"
            android:visibility="visible"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearLayoutLastColumn"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_weight="0.5"
        android:orientation="vertical">
        <TextView
            android:id="@+id/textViewMarks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorLightBlack"
            android:gravity="center_horizontal|bottom"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:text="Marks"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/textViewMarksObtained"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorLightBlack"
            android:gravity="center_horizontal|top"
            android:textColor="@color/colorWhite"
            android:textSize="20sp"
            android:text="NA"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/textViewWatchVideo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorLightBlack"
            android:gravity="center"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:text="Watch video"/>
    </LinearLayout>

</LinearLayout>