<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/imageViewTopRight"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginRight="5dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/star"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/imageViewSubjectImage"
        android:layout_width="@dimen/subject_image_width"
        android:layout_height="@dimen/subject_image_width"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/science"/>

    <TextView
        android:id="@+id/textViewVerticalLine"
        android:layout_height="@dimen/subject_image_width"
        android:layout_width="2dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toRightOf="@+id/imageViewSubjectImage"
        android:background="#FFff80"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/textViewVerticalLine"
        android:layout_centerVertical="true"
        android:gravity="center">

    <TextView
        android:id="@+id/textViewSubjectName"
        android:text="Science"
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFF"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:textSize="@dimen/subject_text_size"
        />

    <TextView
        android:id="@+id/textViewTagLine"
        android:text="Participate and win exciting prizes."
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:textColor="@color/tag_line_text_color"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/textViewSubjectName"
        android:textSize="@dimen/tag_line_font_size"
        />
    </RelativeLayout>
</RelativeLayout>